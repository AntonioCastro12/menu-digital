# Variables de entorno para Netlify Functions y Menú Digital
# En Netlify: Configurar en Site Settings -> Environment Variables

# Contraseña maestra de administración para el panel (Se recomienda alfanumérica segura)
ADMIN_PASSWORD=MiRestauranteSeguro2026!

# Clave secreta para firmar tokens de sesión HMAC SHA-256 (mínimo 32 caracteres)
ADMIN_JWT_SECRET=super_secreto_para_firma_de_sesiones_admin_987654321

# Tiempo de expiración de sesión de administrador en segundos (por defecto: 86400 = 24 horas)
SESSION_DURATION_SECONDS=86400

# Netlify Blobs: Netlify lo provee automáticamente en producción y en 'netlify dev'.
# Para pruebas locales independientes de Netlify CLI, el sistema incluye un adaptador local persistente en .local-blobs/
